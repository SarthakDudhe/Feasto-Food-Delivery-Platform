# Feasto Server Environment Variables Configuration
PORT=4000

# MongoDB Connection String (Atlas or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/feasto?retryWrites=true&w=majority

# JWT Token Secret Key for User Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Stripe Payment Gateway Secret Key
STRIPE_SECRET_KEY=sk_test_51Px...your_stripe_secret_key

# Google Gemini AI API Key for Foodbot Recipe Assistant
GEMINI_API_KEY=AIzaSy...your_gemini_api_key
